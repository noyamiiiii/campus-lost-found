# 复制为 deploy/.env.docker 后按需修改：
#   copy .env.docker.example .env.docker
#   docker compose -f docker-compose.prod.yml --env-file .env.docker up -d --build

# 前端对外端口（浏览器访问 http://localhost:8088）
CLF_HTTP_PORT=8088

# 数据库
CLF_MYSQL_DATABASE=lostfound
CLF_MYSQL_USER=lostfound
CLF_MYSQL_PASSWORD=clf_dev_pass
CLF_MYSQL_ROOT_PASSWORD=clf_dev_root

# 令牌签名密钥：对外分享前务必换成随机串（openssl rand -base64 32）
CLF_JWT_SECRET=change-this-secret-before-sharing

# 图片存储：local（默认，存容器卷）或 s3
STORAGE_PROVIDER=local
STORAGE_S3_BUCKET=lostfound
# provider=s3 时，把 publicBaseUrl 指到能被浏览器访问的地址
STORAGE_S3_PUBLIC_BASE_URL=

# 启用 --profile s3 时的 MinIO 账号
MINIO_ROOT_USER=clfadmin
MINIO_ROOT_PASSWORD=clf_dev_minio
CLF_MINIO_API_PORT=9000
CLF_MINIO_CONSOLE_PORT=9001
# 复制为 deploy/.env 后按需修改；.env 不提交到版本库。
# 以下全部是本地开发默认值，禁止用于任何对外环境。

TZ=Asia/Shanghai

MYSQL_ROOT_PASSWORD=clf_dev_root
MYSQL_DATABASE=lostfound
MYSQL_USER=lostfound
MYSQL_PASSWORD=clf_dev_pass
MYSQL_PORT=3306

REDIS_PASSWORD=clf_dev_redis
REDIS_PORT=6379

MINIO_ROOT_USER=clfadmin
MINIO_ROOT_PASSWORD=clf_dev_minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# 生产部署前必须替换为随机 32 字节以上的值
JWT_SECRET=change_me_before_deploy


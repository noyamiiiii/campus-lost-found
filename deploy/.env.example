# 复制为 deploy/.env 后按需修改；.env 不提交到版本库。
# 以下全部是本地开发默认值，禁止用于任何对外环境。

TZ=Asia/Shanghai

MYSQL_ROOT_PASSWORD=clf_dev_root
MYSQL_DATABASE=lostfound
MYSQL_USER=lostfound
MYSQL_PASSWORD=clf_dev_pass
MYSQL_PORT=3306

REDIS_PASSWORD=clf_dev_redis
REDIS_PORT=6379

MINIO_ROOT_USER=clfadmin
MINIO_ROOT_PASSWORD=clf_dev_minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# 生产部署前必须替换为随机 32 字节以上的值
JWT_SECRET=change_me_before_deploy

# 后端图片存储：local=写 backend/data/files（默认，无需 MinIO）；s3=写 MinIO 的桶
STORAGE_PROVIDER=local
STORAGE_S3_ENDPOINT=http://127.0.0.1:9000
STORAGE_S3_BUCKET=lostfound
STORAGE_S3_ACCESS_KEY=clfadmin
STORAGE_S3_SECRET_KEY=clf_dev_minio
# 切到 s3 后必须改成浏览器能访问的地址，否则详情页图片是裂图
STORAGE_S3_PUBLIC_BASE_URL=
# 单张图片上限（字节）与每帖最多图片数
STORAGE_MAX_FILE_BYTES=5242880
STORAGE_MAX_IMAGES_PER_POST=6

